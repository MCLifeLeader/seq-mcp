{
  "name": "mcp-seq-otel",
  "version": "0.3.1",
  "description": "Standalone MCP server for querying Datalust Seq. Home page for Datalust Seq can be found at https://datalust.co/",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "validate:live-contract": "tsx src/live-contract-check.ts",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.8.2"
  }
}
