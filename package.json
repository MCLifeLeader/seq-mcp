{
  "name": "mcp-seq-otlp",
  "version": "0.4.1",
  "description": "Standalone MCP server for querying Datalust Seq. Home page for Datalust Seq can be found at https://datalust.co/",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --check \"**/*.{json,md,ts,js,mjs,yml,yaml}\"",
    "format:write": "prettier --write \"**/*.{json,md,ts,js,mjs,yml,yaml}\"",
    "validate:live-contract": "tsx src/live-contract-check.ts",
    "test": "npm run build && node --test"
  },
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
